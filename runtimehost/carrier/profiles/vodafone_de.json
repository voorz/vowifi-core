{
  "id": "vodafone_de",
  "name": "vodafone_de",
  "mcc": "262",
  "mnc": "02",
  "ike": {
    "addr": "epdg.vodafone.de",
    "apn": "ims",
    "dpd_interval": 600,
    "enable_esn": true,
    "esp_proposals": [
      "aes256-sha256",
      "aes128-sha256"
    ],
    "ip_stack": "ipv4",
    "proposals": [
      "aes256-sha256-modp2048"
    ],
    "reauth_interval": 80000,
    "replay_window": 12,
    "rf_off_delay": 5
  },
  "eap": {
    "identity_source": "isim",
    "app_preference": "usim"
  },
  "ims": {
    "contact_features": "ims_features",
    "include_cellular_network": true,
    "include_require_sec_agree": true,
    "sec_agree_mode": "on",
    "require_sec_agree": true,
    "proxy_require_sec_agree": true,
    "use_plain_digest_placeholder": true,
    "initial_authorization": "none",
    "include_pani": true,
    "include_pani_authenticated": true,
    "strict_security_server_offer": true,
    "enable_initial_reject_fallback": true,
    "user_agent": "User-Agent: Apple iPhone17,2/26.6 (17,2; iOS 26.6; 23G82) Boot/3.0.0 VoIP/1.0 Carrier/59.0",
    "supported_header": "path,sec-agree",
    "allow_header": "OPTIONS,REGISTER,SUBSCRIBE,NOTIFY,PUBLISH,INVITE,ACK,BYE,CANCEL,UPDATE,PRACK,REFER,INFO,MESSAGE",
    "security_client_format": "full_spaced",
    "include_accept_contact": true,
    "include_p_preferred_id": true,
    "include_p_visited_network_id": true,
    "include_p_access_network_info": true,
    "include_route": true,
    "include_security_client": true,
    "security_client_mechanisms": [
      {
        "alg": "hmac-md5-96",
        "ealg": "des-ede3-cbc",
        "prot": "esp",
        "mode": "trans"
      },
      {
        "alg": "hmac-md5-96",
        "ealg": "aes-cbc",
        "prot": "esp",
        "mode": "trans"
      },
      {
        "alg": "hmac-md5-96",
        "ealg": "null",
        "prot": "esp",
        "mode": "trans"
      },
      {
        "alg": "hmac-sha-1-96",
        "ealg": "des-ede3-cbc",
        "prot": "esp",
        "mode": "trans"
      },
      {
        "alg": "hmac-sha-1-96",
        "ealg": "aes-cbc",
        "prot": "esp",
        "mode": "trans"
      },
      {
        "alg": "hmac-sha-1-96",
        "ealg": "null",
        "prot": "esp",
        "mode": "trans"
      }
    ],
    "transport_mode": "auto",
    "expires": 7200,
    "register_policy": {
      "id": "adaptive-default",
      "temporary_status_codes": [
        408,
        480,
        500,
        502,
        503,
        504
      ],
      "forbidden_status_codes": [
        403
      ],
      "initial_reject_fallback_status_codes": [
        400,
        403,
        480,
        500
      ]
    }
  },
  "e911": {
    "entitlement_endpoint": "https://es-de.vodafone.com:4445/ium-OEMInterface/servlet/IUMServlet"
  },
  "device": {
    "ims_tac": 0,
    "ims_cell_id": 0
  },
  "blocked": false
}
